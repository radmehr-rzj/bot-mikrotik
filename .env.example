# ==============================================================
# فقط این دو مقدار برای بالا آمدن اولیه ربات لازم است.
# نصب‌کننده (install.sh) همین دو مقدار را از شما می‌پرسد و این فایل را می‌سازد.
# بقیه تنظیمات (اطلاعات میکروتیک، شماره کارت، قیمت‌ها و ...) را بعداً از
# داخل خود ربات و با دستور /settings وارد می‌کنید — نیازی به ویرایش این
# فایل نیست.
# ==============================================================

BOT_TOKEN=توکن_ربات_از_بات‌فادر
ADMIN_ID=آیدی_عددی_تلگرام_شما

# ------------------------------------------------------------
# همه موارد زیر اختیاری‌اند و اگر خالی بمانند، از پنل /settings
# داخل خود ربات قابل تنظیم‌اند (بدون نیاز به دسترسی سرور یا ری‌استارت).
# فقط برای مرجع اینجا فهرست شده‌اند:
# ------------------------------------------------------------
# MIKROTIK_HOST=
# MIKROTIK_USER=
# MIKROTIK_PASSWORD=
# MIKROTIK_PORT=8728
# MIKROTIK_USE_SSL=false
# PROFILE_1_MONTH=30Day
# PROFILE_2_MONTH=60Day
# CARD_NUMBER=
# CARD_HOLDER_NAME=
# PRICE_1_MONTH=
# PRICE_2_MONTH=
# SUPPORT_USERNAME=
# VPN_SERVER_HOST=
# EXTRA_USER_PRICE_1_MONTH=
# EXTRA_USER_PRICE_2_MONTH=
# MAX_EXTRA_USERS=5
# SELF_SERVICE_COOLDOWN_HOURS=24
# PENDING_REQUEST_TIMEOUT_HOURS=48
# BACKUP_AUTO_ENABLED=true
# BACKUP_INTERVAL_HOURS=24
